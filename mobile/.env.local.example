# Stopgap cloud transcription (spec: ../.project/specs/phone-recorder-on-device.md):
# fills in the server URL + token so Clip gets a transcript with no Settings
# step, while on-device transcription still needs a dev-client build. Copy to
# .env.local (gitignored — EXPO_PUBLIC_* vars get inlined into the built app,
# so the real token belongs only there, never in this committed template or
# in source) and restart `expo start` to pick it up.
EXPO_PUBLIC_PHONE_SERVER_URL=http://<your Mac's LAN IP>:8787
EXPO_PUBLIC_PHONE_TOKEN=<the PHONE_TOKEN from the repo root .env>
