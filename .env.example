DISCORD_BOT_TOKEN=
MEETINGS_DIR=
# (Ignored under Docker — compose forces MEETINGS_DIR=/data on a volume.)
# Comma-separated guild snowflakes; /record /stop register in each of them.
GUILD_IDS=
# Opus bitrate cap for master-<ts>.ogg (mono, voip-optimized). Default 24k.
# 24k ≈ 10.8 MB/h continuous-audio worst case (Opus VBR can overshoot the
# nominal bitrate a little; real meetings are well under that — silence
# compresses away).
# Raise to 32k/48k for headroom — note 2h @ 32k ≈ 28 MB exceeds Discord's
# 25 MB upload cap; then the master stays on disk with a path log.
# v3.0.0: the master mix is ALWAYS produced (every session records the
# per-user tracks AND the mix), so ffmpeg is required for every session —
# without it the mix stays a stereo .wav on disk and is never DM'd.
# MASTER_BITRATE=24k
# Auto-stop failsafe threshold, whole minutes 1-180. Runtime-changeable via
# /autostop; stored per guild, persisted across restarts — the env value only
# seeds guilds that haven't set their own.
AUTO_STOP_MINUTES=5
# Produce-gate for transcription (v3.0.0), runtime-toggleable per guild with
# /transcribe. Transcription always runs on the PER-USER tracks (there is no
# mode any more) and produces ONE speaker-attributed transcript-<ts>.md per
# session. Whether that file is DM'd is a separate per-guild runtime setting —
# /dm transcribe TRUE|FALSE — with no env var, so an env value can never
# silently turn DM sending on. Degrades gracefully (one log line, recording
# flow unchanged) when python/faster-whisper are absent.
# TRANSCRIBE=TRUE
# SQLite database file for per-guild settings + guild ledger.
# Default when unset: <MEETINGS_DIR>/recorder.db. Under Docker, compose sets
# DB_PATH=/data/recorder.db (the recordings named volume) so settings persist
# across redeploys; see docker-compose.yml for the commented-out host-disk
# alternative — bind a host directory, never a single file (WAL creates
# -wal/-shm sidecars).
# DB_PATH=
# Whisper model for the sidecar: tiny/base/small/medium/large-v3 (and friends).
# Default small (multilingual, ~460 MB — downloaded from HuggingFace on first
# run into the HF cache dir, /data/.cache under Docker, so the download
# persists across redeploys there).
# WHISPER_MODEL=small
# Accepts a faster-whisper model name (tiny/base/small/medium/large-v3) or an
# HuggingFace repo id (e.g. Systran/faster-whisper-small).
# Absolute path to the Python interpreter for the sidecar (must have
# faster-whisper installed). Default: platform python on PATH. On multi-Python
# Windows hosts, bare "python" may resolve to an interpreter WITHOUT
# faster-whisper — point this at the right one, e.g.
# WHISPER_PYTHON=C:\Users\you\anaconda3\envs\whisper\python.exe. Under Docker
# this stays commented: the image's /opt/venv/bin is first on PATH.
# WHISPER_PYTHON=
# CPU threads the sidecar may use (integer, default 4). Caps ctranslate2 so a
# post-meeting transcription leaves headroom for live voice even if both run at
# once; lower it on small VPSes (e.g. 2 on a 2-core box).
# WHISPER_CPU_THREADS=4

# --- Invite notetaker (npm run notetaker) — separate process, preview ---
# Add NOTETAKER_EMAIL to a Google Meet / Zoom invite and the notetaker picks the
# invite up from that mailbox and schedules it. (The joiner is not built yet:
# a due meeting is only logged as "would join".) None of these are read by the
# Discord bot, and the Discord variables are not needed by the notetaker.
# Mailbox that receives the invites (Zoho Mail for spotslocal.com).
# NOTETAKER_EMAIL=support@spotslocal.com
# Zoho APP-SPECIFIC password (Zoho → My Account → Security → App Passwords),
# never the account password. IMAP access must be enabled in Zoho Mail settings.
# The inbox is opened READ-ONLY: nothing is marked read, moved or deleted.
# NOTETAKER_APP_PASSWORD=
# Consent guard, REQUIRED: only invites whose ORGANIZER matches an entry here
# are scheduled (exact emails and/or exact @domain entries, comma-separated).
# Anyone else's invite is logged and ignored, so a customer inviting the
# address is never recorded.
# NOTETAKER_ALLOWED_ORGANIZERS=@spotslocal.com
# Name the bot joins under (visible to every participant). Default below.
# NOTETAKER_BOT_NAME=SpotsLocal Recorder
# IMAP server (default imap.zoho.com:993; Zoho paid org accounts may use imappro.zoho.com).
# NOTETAKER_IMAP_HOST=imap.zoho.com
# NOTETAKER_IMAP_PORT=993
# Schedule database (separate from DB_PATH). Default <MEETINGS_DIR>/notetaker.db.
# NOTETAKER_DB_PATH=
# Seconds between mailbox polls (15-3600, default 60) and how many days back
# a poll looks for invites (1-90, default 14).
# NOTETAKER_POLL_SECONDS=60
# NOTETAKER_LOOKBACK_DAYS=14
# Minutes to wait in the Meet lobby for someone to admit the bot (1-60, default 10).
# NOTETAKER_ADMIT_TIMEOUT_MIN=10
# Chrome profile the bot joins with. Sign it in once with `npm run notetaker:login`
# (as NOTETAKER_EMAIL): meetings run by personal Google accounts usually refuse
# signed-out guests. Default <MEETINGS_DIR>/notetaker-browser.
# NOTETAKER_BROWSER_PROFILE=
# Chrome/Chromium binary (absolute path). Default: the first of
# /usr/bin/google-chrome-stable, google-chrome, chromium, chromium-browser.
# NOTETAKER_CHROME_PATH=
# Run Chrome without a window (true/false, default false). Headless needs no
# desktop but Meet is more likely to refuse it.
# NOTETAKER_HEADLESS=false
# The notetaker transcribes with the same sidecar as the bot: WHISPER_MODEL and
# WHISPER_PYTHON above apply (WHISPER_PYTHON = a python with faster-whisper).

# ---------------------------------------------------------------------------
# Phone recorder server (`npm run phone-server`) — receives 1-minute audio
# chunks from the phone app, transcribes them with the Whisper sidecar above,
# keeps clips and deletes everything else after the device's window.
# Spec: .project/specs/phone-recorder.md
# ---------------------------------------------------------------------------
# REQUIRED to run it: the app's bearer token, 24+ random characters
# (e.g. `openssl rand -hex 24`).
# PHONE_TOKEN=
# Address to listen on. Default 127.0.0.1 (this machine only); set it to your
# Tailscale address (`tailscale ip -4`, a 100.x address) so the phone can reach it.
# PHONE_BIND=127.0.0.1
# PHONE_PORT=8787
# Database (separate from DB_PATH and NOTETAKER_DB_PATH). Default <MEETINGS_DIR>/phone.db.
# PHONE_DB_PATH=
# Window for a device that has not set one yet, in minutes (1-1440, default 60).
# PHONE_DEFAULT_WINDOW_MINUTES=60
# Largest accepted chunk upload in MB (1-500, default 50).
# PHONE_MAX_CHUNK_MB=50
